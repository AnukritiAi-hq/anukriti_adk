# ----------------------------------------------------------------------------
# Anukriti ADK — configuration. Copy to .env. DO NOT commit real secrets.
# ----------------------------------------------------------------------------

# Gemini access (only needed for a LIVE agent run / live eval).
# Get a key: https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Use Google AI Studio (TRUE) vs Vertex AI (FALSE). ADK reads this.
GOOGLE_GENAI_USE_VERTEXAI=FALSE

# Gemini model for both agents (must be identical to isolate the optimization).
ANUKRITI_ADK_MODEL=gemini-2.5-flash

# ----------------------------------------------------------------------------
# PGx engine mode.
#   offline (default): tools compute results from pinned CPIC-derived tables
#                      in tools.py — zero network, fully reproducible for judges.
#   api:               call a deployed anukriti-api POST /runs instead.
# ----------------------------------------------------------------------------
ANUKRITI_ENGINE_MODE=offline
ANUKRITI_API_URL=
ANUKRITI_API_TOKEN=
